{
    "name": "north-web-dev/fpm-doctor",
    "description": "Diagnose and tune PHP-FPM pools: measured pm.max_children recommendations, shared-pool 502-storm detection, and slowlog analysis.",
    "type": "project",
    "keywords": ["php-fpm", "fpm", "ops", "devops", "performance", "tuning", "max_children", "slowlog", "cli"],
    "homepage": "https://github.com/North-web-dev/fpm-doctor",
    "license": "MIT",
    "authors": [
        {
            "name": "North-web-dev",
            "email": "iskandarkhon1221@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "friendsofphp/php-cs-fixer": "^3.64"
    },
    "autoload": {
        "psr-4": {
            "FpmDoctor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FpmDoctor\\Tests\\": "tests/"
        }
    },
    "bin": ["bin/fpm-doctor"],
    "scripts": {
        "test": "phpunit",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
